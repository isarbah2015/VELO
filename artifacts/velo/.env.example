# Copy to .env and fill in. Values prefixed EXPO_PUBLIC_ are bundled into the
# app (safe: public keys / URLs only). Secrets live in Cloud Functions, never here.

# ---- Paystack (wallet top-ups) -----------------------------------------
# Deployed URL of the `paystackApi` Cloud Function. After `firebase deploy`
# it's printed in the CLI; default assumes us-central1 / velo-ride-gh.
EXPO_PUBLIC_PAYSTACK_API_URL=https://us-central1-velo-ride-gh.cloudfunctions.net/paystackApi

# The SECRET/PUBLIC keys are NOT set here. Set them on the backend:
#   firebase functions:secrets:set PAYSTACK_SECRET_KEY
#   firebase functions:secrets:set PAYSTACK_PUBLIC_KEY
# (Get keys from VELO's own Paystack dashboard — a dedicated account, not the
# shared one other apps like ScoutGrid used to use.)
#
# Every top-up is confirmed by the client calling /verify right after checkout
# (idempotent) and reconciled again on the next app open if that ever misses
# (see reconcilePendingTopups in services/paystack.ts). On top of that, since
# VELO has its own dedicated Paystack account (no shared-webhook-slot
# constraint), also register the deployed paystackWebhook as this account's
# webhook so top-ups still land even if the app never returns to /verify
# (e.g. a bank transfer that settles after the user has closed the app):
#   Paystack dashboard → Settings → API Keys & Webhooks → Webhook URL
#   https://us-central1-velo-ride-gh.cloudfunctions.net/paystackWebhook
# creditWallet() is idempotent per reference either way, so the webhook and
# /verify can both fire for the same payment without double-crediting.

# ---- MapTiler (branded map style) ---------------------------------------
# Falls back to the key already baked into components/LiveMap.tsx if unset, so
# this is optional day-to-day — set it to rotate the key without a code change.
# In the MapTiler dashboard, restrict this key to the app's bundle ID
# (com.velo.ridehailing) / your domains — an EXPO_PUBLIC_ var still ships
# inside the built app, so the dashboard restriction is the actual protection
# against someone else extracting and running up usage on your account.
EXPO_PUBLIC_MAPTILER_KEY=

# ---- Google Sign-In ----------------------------------------------------
# Create OAuth client IDs in Google Cloud Console for the velo-ride-gh project,
# and enable Google as a provider in Firebase Auth. Web client id is used by
# Expo Go; the iOS/Android ids are for standalone builds.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
