rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin/ops: any signed-in user with a doc at admins/{uid}. Used by the VELO
    // Admin web panel to review drivers, monitor trips and triage disputes.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // provisioned out-of-band (console / server), never from a client
    }

    // Every rider/driver account: profile, role, wallet balance.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;

      match /paymentMethods/{methodId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /transactions/{txId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId;
      }
    }

    // Per-driver online status + earnings, separate from the profile doc so
    // rides can read a driver's live status without touching their wallet.
    match /drivers/{driverId} {
      allow read: if signedIn();
      // The driver owns their doc; an admin may set verification status etc.
      allow write: if isAdmin() || (signedIn() && request.auth.uid == driverId);
    }

    // Minimum fare per ride tier (services/pricing.ts FARE[type].minFare) —
    // kept in sync by hand since rules can't import the client's pricing
    // module. Used only as a tamper floor below, not the source of truth for
    // the actual quoted fare (that still depends on real trip distance).
    function minFareFor(type) {
      return type == 'Standard' ? 6 : type == 'Premium' ? 9 : 13;
    }

    // Mirrors the block check in services/driver.ts acceptRide — a driver
    // claiming an open request can't be someone either side has blocked (see
    // services/blocking.ts). Rules-layer copy so a modified client can't skip
    // the client-side check and accept anyway.
    function notBlocked(riderId, driverId) {
      let riderBlocked = exists(/databases/$(database)/documents/users/$(riderId))
        ? get(/databases/$(database)/documents/users/$(riderId)).data.get('blockedUserIds', [])
        : [];
      let driverBlocked = exists(/databases/$(database)/documents/users/$(driverId))
        ? get(/databases/$(database)/documents/users/$(driverId)).data.get('blockedUserIds', [])
        : [];
      return !(driverId in riderBlocked) && !(riderId in driverBlocked);
    }

    // A ride is visible to its rider, its assigned driver, and — while still
    // unassigned and open — to any signed-in driver browsing the request
    // pool. That last case is required for the driver dashboard's
    // `where(status == 'requested')` list query to pass: Firestore rejects a
    // list outright if any matched doc fails the read rule, so a rule that
    // only allowed the owner would reject the whole open-requests query.
    // Riders create their own rides; either party updates status
    // (accept/decline/cancel/complete).
    //
    // `price` is what settleRide (Cloud Function) later debits from the
    // rider's wallet and pays the driver out of — so a client that could set
    // it to anything, or edit it after creation, could book a real trip for
    // a token fare. create requires it to at least clear the tier's fare
    // floor; update forbids changing it (and the tier) at all, since no
    // legitimate flow — accept, decline, cancel, complete — ever needs to.
    match /rides/{rideId} {
      allow read: if isAdmin() || (signedIn() && (
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.status == 'requested'
      ));
      allow create: if signedIn() && request.resource.data.riderId == request.auth.uid
        && request.resource.data.type in ['Standard', 'Premium', 'Bossu']
        && request.resource.data.price is number
        && request.resource.data.price >= minFareFor(request.resource.data.type);
      allow update: if signedIn()
        && (
          resource.data.riderId == request.auth.uid ||
          resource.data.driverId == request.auth.uid ||
          (resource.data.driverId == null && request.resource.data.driverId == request.auth.uid
            && notBlocked(resource.data.riderId, request.auth.uid))
        )
        && request.resource.data.price == resource.data.price
        && request.resource.data.type == resource.data.type
        // Cancellation is free either way, but `cancelledBy` (used to review
        // cancellation patterns) must actually match who's writing it — a
        // rider can't attribute their own cancellation to the driver.
        && (request.resource.data.status != 'cancelled'
          || !('cancelledBy' in request.resource.data)
          || (request.resource.data.cancelledBy == 'rider' && request.auth.uid == resource.data.riderId)
          || (request.resource.data.cancelledBy == 'driver' && request.auth.uid == resource.data.driverId));

      // Per-ride chat: only the ride's rider or assigned driver may read or
      // post. get() reads the parent ride to authorize each message.
      match /messages/{messageId} {
        function ride() {
          return get(/databases/$(database)/documents/rides/$(rideId)).data;
        }
        allow read, create: if signedIn() && (
          ride().riderId == request.auth.uid || ride().driverId == request.auth.uid
        );
      }
    }

    // Public trip-tracking links (the app's "Share" buttons) — a narrow,
    // no-PII mirror of a ride, written only by the trusted mirrorRideForSharing
    // Cloud Function (Admin SDK bypasses rules), never directly by a client.
    // Anyone with the link can read it, by design; it only exists while the
    // rider has sharing on and the trip isn't over (see the function).
    match /publicTracking/{rideId} {
      allow read: if true;
      allow write: if false;
    }

    // Messages submitted from the public support page's contact form
    // (public-tracking/support/index.html) — no VELO account needed, so no
    // signedIn() check, just field bounds against abuse. Write-only from the
    // client: nobody can read, edit, or enumerate other people's messages —
    // triaged from the Firebase console or a future admin-panel view.
    match /supportMessages/{messageId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // Trip disputes / problem reports. A signed-in user files their own report
    // and can read it back; only an admin/ops backend (service account, which
    // bypasses rules) triages or updates them.
    match /disputes/{disputeId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow update: if isAdmin(); // triage / resolve from the admin panel
    }
  }
}
