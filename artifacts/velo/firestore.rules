rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin/ops: any signed-in user with a doc at admins/{uid}. Used by the VELO
    // Admin web panel to review drivers, monitor trips and triage disputes.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // provisioned out-of-band (console / server), never from a client
    }

    // Every rider/driver account: profile, role, wallet balance.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;

      match /paymentMethods/{methodId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /transactions/{txId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId;
      }
    }

    // Per-driver online status + earnings, separate from the profile doc so
    // rides can read a driver's live status without touching their wallet.
    match /drivers/{driverId} {
      allow read: if signedIn();
      // The driver owns their doc; an admin may set verification status etc.
      allow write: if isAdmin() || (signedIn() && request.auth.uid == driverId);
    }

    // A ride is visible to its rider, its assigned driver, and — while still
    // unassigned and open — to any signed-in driver browsing the request
    // pool. That last case is required for the driver dashboard's
    // `where(status == 'requested')` list query to pass: Firestore rejects a
    // list outright if any matched doc fails the read rule, so a rule that
    // only allowed the owner would reject the whole open-requests query.
    // Riders create their own rides; either party updates status
    // (accept/decline/cancel/complete).
    match /rides/{rideId} {
      allow read: if isAdmin() || (signedIn() && (
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.status == 'requested'
      ));
      allow create: if signedIn() && request.resource.data.riderId == request.auth.uid;
      allow update: if signedIn() && (resource.data.riderId == request.auth.uid || resource.data.driverId == request.auth.uid || (resource.data.driverId == null && request.resource.data.driverId == request.auth.uid));

      // Per-ride chat: only the ride's rider or assigned driver may read or
      // post. get() reads the parent ride to authorize each message.
      match /messages/{messageId} {
        function ride() {
          return get(/databases/$(database)/documents/rides/$(rideId)).data;
        }
        allow read, create: if signedIn() && (
          ride().riderId == request.auth.uid || ride().driverId == request.auth.uid
        );
      }
    }

    // Trip disputes / problem reports. A signed-in user files their own report
    // and can read it back; only an admin/ops backend (service account, which
    // bypasses rules) triages or updates them.
    match /disputes/{disputeId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow update: if isAdmin(); // triage / resolve from the admin panel
    }
  }
}
