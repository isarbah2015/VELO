rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // A driver may upload and read only their own verification documents.
    // Review/approval happens via the Admin SDK, which bypasses these rules.
    match /verification/{uid}/{file} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Profile photos: anyone signed in may read them (shown to the other party
    // on a ride); only the owner may upload their own avatar.
    match /avatars/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
